# =============================================================================
# SHOGUN Environment Variables
# Copy to .env.local and fill in values
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Providers (platform keys — used for demo credits only)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_AI_API_KEY=...

# Fly.io
FLY_API_TOKEN=...
FLY_ORG=shogun

# Cloudflare R2
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=shogun-storage

# Stripe
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...

# Stripe Price IDs
STRIPE_PRICE_ANNUAL=price_...    # $49/mo billed annually ($588/yr)
STRIPE_PRICE_MONTHLY=price_...   # $62/mo billed monthly

# Encryption
ENCRYPTION_KEY=your-32-byte-hex-key

# API
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Web Search
BRAVE_SEARCH_API_KEY=         # Optional, DuckDuckGo fallback if not set

# Notification channels
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=...
SENDGRID_API_KEY=             # For email notifications
LINE_CHANNEL_ACCESS_TOKEN=...
LINE_CHANNEL_SECRET=...

# Redis
REDIS_URL=redis://localhost:6379

# Resend (waitlist + transactional email)
RESEND_API_KEY=re_...            # Get from resend.com dashboard
RESEND_AUDIENCE_ID=...           # Audience ID for waitlist contacts

# Rewardful (affiliate tracking)
NEXT_PUBLIC_REWARDFUL_API_KEY=   # Get from rewardful.com dashboard

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Container Agent
AGENT_MASTER_SECRET=your-agent-master-secret
