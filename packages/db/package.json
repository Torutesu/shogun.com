{
  "name": "@shogun/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "db:generate": "supabase gen types typescript --local > src/database.types.ts",
    "db:migrate": "supabase db push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "@shogun/shared": "workspace:*"
  },
  "devDependencies": {
    "supabase": "^2.20.0",
    "typescript": "^5.7.0"
  }
}
